# Baked-in defaults used the first time the app loads (before anyone opens
# Settings and saves their own values, which are then kept in this browser's
# local storage). Copy this file to .env and fill in your real project
# details. Never commit your real .env file.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset
